{
  "name": "todotree",
  "version": "1.7.0",
  "description": "Windows 桌面任务树工具：基于本地 Markdown 文件，支持 Win32 桌面层固定、四分区子任务管理、DDL 提醒、三套主题与 20 份滚动备份，无需注册、不传云端。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "test": "node --test test/*.test.js",
    "preview": "python -m http.server 8765 --bind 127.0.0.1 --directory renderer",
    "demo": "electron . --demo"
  },
  "build": {
    "appId": "com.todotree.app",
    "productName": "Todo",
    "executableName": "TodoTree",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "Todo-Setup-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "desktop-layer.js",
      "renderer/**",
      "node_modules/**",
      "package.json",
      "LICENSE",
      "lib/**",
      "examples/**"
    ]
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.2.1"
  },
  "author": "yunyancuo",
  "homepage": "https://github.com/Infinite-Monkey-Lab/todotree",
  "repository": {
    "type": "git",
    "url": "https://github.com/Infinite-Monkey-Lab/todotree.git"
  },
  "keywords": [
    "windows",
    "desktop-widget",
    "todo",
    "todoapp",
    "markdown",
    "electron",
    "task-management",
    "productivity",
    "todolist",
    "local-first"
  ]
}
