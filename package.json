{
  "name": "todotree",
  "version": "1.6.1",
  "description": "暗金半透明桌面待办工具 - 4 分区自动化任务管理",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.todotree.app",
    "productName": "TodoTree",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "TodoTree-Setup-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "desktop-layer.js",
      "renderer/**",
      "node_modules/**",
      "package.json",
      "LICENSE"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.2.1"
  }
}
